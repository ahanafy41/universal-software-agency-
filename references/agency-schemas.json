{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal Agency Schemas",
  "description": "Unified JSON schema catalog for universal software agency manifests, support tickets, and specifications.",
  "definitions": {
    "project_spec": {
      "type": "object",
      "required": ["project_name", "version", "track", "language", "entry_point", "architecture_pattern", "modules", "accessibility_standard", "diagnostics"],
      "properties": {
        "project_name": { "type": "string" },
        "version": { "type": "string" },
        "track": { "type": "string", "enum": ["Track A (Desktop & Offline)", "Track B (Universal Web & Cloud APIs)", "Track C (High-Performance Systems & Backend)"] },
        "language": { "type": "string" },
        "entry_point": { "type": "string" },
        "architecture_pattern": { "type": "string" },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path", "responsibility"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "responsibility": { "type": "string" }
            }
          }
        },
        "accessibility_standard": { "type": "string" },
        "diagnostics": {
          "type": "object",
          "required": ["doctor_flag", "error_log"],
          "properties": {
            "doctor_flag": { "type": "string" },
            "error_log": { "type": "string" }
          }
        }
      }
    },
    "support_ticket": {
      "type": "object",
      "required": ["ticket_id", "severity", "status", "symptoms", "diagnostic_branch", "proposed_patch_plan", "approval_gate"],
      "properties": {
        "ticket_id": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "status": { "type": "string", "enum": ["OPEN", "INVESTIGATING", "AWAITING_APPROVAL", "APPROVED", "REJECTED", "EXECUTING", "VERIFIED", "CLOSED"] },
        "symptoms": { "type": "string" },
        "runtime_logs": { "type": "string" },
        "live_search_findings": { "type": "string" },
        "diagnostic_branch": { "type": "string", "enum": ["Branch A (API Contract)", "Branch B (Concurrency)", "Branch C (Data Boundary)"] },
        "fault_location": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "line_range": { "type": "string" },
            "ast_node": { "type": "string" }
          }
        },
        "proposed_patch_plan": { "type": "string" },
        "approval_gate": {
          "type": "object",
          "required": ["approved"],
          "properties": {
            "approved": { "type": "boolean" },
            "user_notes": { "type": "string" }
          }
        }
      }
    },
    "debug_manifest": {
      "type": "object",
      "required": ["issue_id", "severity", "diagnostic_branch", "exact_location", "reproduction_command", "root_cause_hypothesis", "fix_status"],
      "properties": {
        "issue_id": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "diagnostic_branch": { "type": "string", "enum": ["Branch A (Contract)", "Branch B (Lifecycle)", "Branch C (Data)"] },
        "exact_location": {
          "type": "object",
          "required": ["file", "line_range", "ast_node"],
          "properties": {
            "file": { "type": "string" },
            "line_range": { "type": "string" },
            "ast_node": { "type": "string" }
          }
        },
        "reproduction_command": { "type": "string" },
        "root_cause_hypothesis": { "type": "string" },
        "fix_status": { "type": "string", "enum": ["Diagnosed", "In-Progress", "Fixed", "Verified"] }
      }
    },
    "references_manifest": {
      "type": "object",
      "required": ["extracted_at", "total_symbols", "modules"],
      "properties": {
        "extracted_at": { "type": "string" },
        "total_symbols": { "type": "integer" },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module_name", "source_file", "symbols"],
            "properties": {
              "module_name": { "type": "string" },
              "source_file": { "type": "string" },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "kind", "signature"],
                  "properties": {
                    "name": { "type": "string" },
                    "kind": { "type": "string" },
                    "signature": { "type": "string" },
                    "constraints": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "craftsmanship_rules": {
      "type": "object",
      "required": ["version", "rules"],
      "properties": {
        "version": { "type": "string" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "severity", "description"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "severity": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
