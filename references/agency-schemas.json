{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal Software Agency Unified Schema Catalog",
  "definitions": {
    "project_spec": {
      "type": "object",
      "required": ["project_name", "architecture_tier", "primary_language", "scoping_mode", "components"],
      "properties": {
        "project_name": { "type": "string" },
        "architecture_tier": { "type": "string", "enum": ["Track A (Desktop/Offline)", "Track B (Web/API)", "Track C (Systems/CLI)"] },
        "primary_language": { "type": "string" },
        "scoping_mode": { "type": "string", "enum": ["Interactive", "Fast-Track"] },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "tier", "file_path"],
            "properties": {
              "name": { "type": "string" },
              "tier": { "type": "string", "enum": ["UI/Accessibility", "Core Logic", "Data Engine", "CLI/Runner"] },
              "file_path": { "type": "string" }
            }
          }
        },
        "accessibility_standards": {
          "type": "object",
          "properties": {
            "keyboard_navigable": { "type": "boolean" },
            "aria_landmarks": { "type": "boolean" },
            "clean_terminal_output": { "type": "boolean" }
          }
        }
      }
    },
    "debug_manifest": {
      "type": "object",
      "required": ["issue_id", "status", "root_cause_branch", "fault_location"],
      "properties": {
        "issue_id": { "type": "string" },
        "status": { "type": "string", "enum": ["TRIAGING", "REPRODUCED", "DIAGNOSED", "FIXED", "VERIFIED"] },
        "root_cause_branch": { "type": "string", "enum": ["Branch A (API Contract)", "Branch B (Concurrency/Lifecycle)", "Branch C (Data Boundary)"] },
        "fault_location": {
          "type": "object",
          "required": ["file", "line_number"],
          "properties": {
            "file": { "type": "string" },
            "line_number": { "type": "integer" },
            "ast_node": { "type": "string" },
            "faulty_snippet": { "type": "string" }
          }
        },
        "blast_radius_limit": {
          "type": "object",
          "properties": {
            "max_churn_lines": { "type": "integer", "default": 50 },
            "backup_path": { "type": "string" }
          }
        }
      }
    },
    "references_manifest": {
      "type": "object",
      "required": ["source_doc", "ingestion_timestamp", "symbols"],
      "properties": {
        "source_doc": { "type": "string" },
        "ingestion_timestamp": { "type": "string" },
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string", "enum": ["function", "class", "interface", "constant", "endpoint"] },
              "parameters": { "type": "array" },
              "return_type": { "type": "string" },
              "constraints": { "type": "string" }
            }
          }
        }
      }
    },
    "craftsmanship_rules": {
      "type": "object",
      "properties": {
        "atomic_io": { "type": "boolean", "default": true },
        "actionable_errors": { "type": "boolean", "default": true },
        "doctor_self_check": { "type": "boolean", "default": true },
        "graceful_shutdown": { "type": "boolean", "default": true },
        "structured_logging": { "type": "boolean", "default": true },
        "universal_accessibility": { "type": "boolean", "default": true }
      }
    }
  }
}
