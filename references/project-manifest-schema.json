{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectSpec",
  "type": "object",
  "required": [
    "project_name",
    "version",
    "track",
    "language",
    "framework",
    "architecture_tiers",
    "offline_support"
  ],
  "properties": {
    "project_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "track": {
      "type": "string",
      "enum": [
        "Track_A_Desktop",
        "Track_B_Web_API",
        "Track_C_Automation_CLI"
      ]
    },
    "language": {
      "type": "string"
    },
    "framework": {
      "type": "string"
    },
    "offline_support": {
      "type": "boolean"
    },
    "architecture_tiers": {
      "type": "object",
      "required": [
        "ui",
        "core",
        "data"
      ],
      "properties": {
        "ui": {
          "type": "object",
          "properties": {
            "framework": {
              "type": "string"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "core": {
          "type": "object",
          "properties": {
            "modules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exported_functions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "storage_type": {
              "type": "string",
              "enum": [
                "sqlite",
                "litedb",
                "json_store",
                "in_memory"
              ]
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "launchers": {
      "type": "object",
      "properties": {
        "linux_termux": {
          "type": "string"
        },
        "windows": {
          "type": "string"
        }
      }
    }
  }
}