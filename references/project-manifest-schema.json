{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UniversalProjectManifest",
  "type": "object",
  "required": [
    "project_name",
    "version",
    "target_languages",
    "architecture_tier",
    "modules"
  ],
  "properties": {
    "project_name": { "type": "string" },
    "version": { "type": "string" },
    "target_languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "architecture_tier": {
      "type": "string",
      "enum": ["single-tier", "2-tier", "3-tier-enterprise", "microservices", "cli-tool"]
    },
    "offline_first": { "type": "boolean" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "role"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["ui", "core-logic", "data-access", "diagnostic", "infrastructure"]
          },
          "status": {
            "type": "string",
            "enum": ["planned", "in-progress", "completed", "tested"]
          }
        }
      }
    }
  }
}