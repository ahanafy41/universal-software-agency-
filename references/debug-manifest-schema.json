{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DebugManifestSchema",
  "type": "object",
  "required": ["issue_id", "severity", "environment", "exact_location", "diagnostic_branch", "verification_status"],
  "properties": {
    "issue_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "runtime": { "type": "string" },
        "sdk_version": { "type": "string" }
      }
    },
    "exact_location": {
      "type": "object",
      "required": ["file_path", "line_number", "symbol_name"],
      "properties": {
        "file_path": { "type": "string" },
        "line_number": { "type": "integer" },
        "symbol_name": { "type": "string" },
        "failing_snippet": { "type": "string" }
      }
    },
    "diagnostic_branch": {
      "type": "string",
      "enum": ["Branch A: API/Contract", "Branch B: Lifecycle/Concurrency", "Branch C: Data/Nullability"]
    },
    "backup_path": { "type": "string" },
    "verification_status": {
      "type": "string",
      "enum": ["isolated", "patched", "verified", "reverted"]
    }
  }
}