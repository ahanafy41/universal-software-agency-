{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DebugManifest",
  "type": "object",
  "required": [
    "issue_id",
    "timestamp",
    "severity",
    "environment",
    "target_location",
    "diagnostic_evaluation",
    "verification"
  ],
  "properties": {
    "issue_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"]
    },
    "language": {
      "type": "string"
    },
    "reproduction_command": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "required": ["os", "runtime"],
      "properties": {
        "os": { "type": "string" },
        "runtime": { "type": "string" },
        "framework_version": { "type": "string" }
      }
    },
    "target_location": {
      "type": "object",
      "required": ["file_path", "line_number", "symbol_name", "snippet"],
      "properties": {
        "file_path": { "type": "string" },
        "line_number": { "type": "integer" },
        "symbol_name": { "type": "string" },
        "snippet": { "type": "string" }
      }
    },
    "diagnostic_evaluation": {
      "type": "object",
      "required": ["branch_a", "branch_b", "branch_c", "root_cause"],
      "properties": {
        "branch_a": { "type": "string" },
        "branch_b": { "type": "string" },
        "branch_c": { "type": "string" },
        "root_cause": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["linter_passed", "zero_side_effects_confirmed"],
      "properties": {
        "backup_snapshot_path": { "type": "string" },
        "linter_passed": { "type": "boolean" },
        "test_suite_passed": { "type": "boolean" },
        "diff_churn_percent": { "type": "number" },
        "zero_side_effects_confirmed": { "type": "boolean" }
      }
    }
  }
}
