{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReferencesManifest",
  "type": "object",
  "required": ["version", "references"],
  "properties": {
    "version": { "type": "string" },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "file_path", "doc_type", "summary"],
        "properties": {
          "title": { "type": "string" },
          "file_path": { "type": "string" },
          "language": { "type": "string" },
          "doc_type": {
            "type": "string",
            "enum": [
              "markdown_guide",
              "json_schema",
              "api_spec",
              "type_definitions",
              "code_sample",
              "rules_and_constraints",
              "cheat_sheet"
            ]
          },
          "summary": { "type": "string" },
          "key_symbols": {
            "type": "array",
            "items": { "type": "string" }
          },
          "strict_rules": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
