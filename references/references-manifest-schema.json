{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReferencesManifest",
  "type": "object",
  "required": [
    "references"
  ],
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "file_path",
          "doc_type",
          "summary",
          "key_symbols",
          "strict_rules"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "doc_type": {
            "type": "string",
            "enum": [
              "json_schema",
              "api_spec",
              "markdown_guide",
              "type_definitions",
              "code_sample"
            ]
          },
          "summary": {
            "type": "string"
          },
          "key_symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strict_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}